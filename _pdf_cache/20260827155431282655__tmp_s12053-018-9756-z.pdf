            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Rural electrification in Kenya: a useful case for remote areas in sub-Saharan Africa</rdf:li>
            </rdf:Alt>
         </dc:title>
